<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="AppTitle">SpaceSweeper</sys:String>
    <sys:String x:Key="PathLabel">路径</sys:String>
    <sys:String x:Key="BrowseButton">选择</sys:String>
    <sys:String x:Key="ScanButton">扫描</sys:String>
    <sys:String x:Key="CancelButton">取消</sys:String>
    <sys:String x:Key="CleanupButton">清理</sys:String>
    <sys:String x:Key="TreeTitle">目录树</sys:String>
    <sys:String x:Key="TreemapTitle">空间矩形图</sys:String>
    <sys:String x:Key="ChildrenTitle">当前目录内容</sys:String>
    <sys:String x:Key="NameColumn">名称</sys:String>
    <sys:String x:Key="SizeColumn">大小</sys:String>
    <sys:String x:Key="FilesColumn">文件</sys:String>
    <sys:String x:Key="FoldersColumn">目录</sys:String>
    <sys:String x:Key="StatusReady">就绪</sys:String>
    <sys:String x:Key="StatusPreparing">准备扫描...</sys:String>
    <sys:String x:Key="StatusScanningFormat">扫描中：{0} 项，已统计 {1}，错误 {2}</sys:String>
    <sys:String x:Key="StatusCompletedFormat">完成：{0}，总计 {1}，文件 {2}，目录 {3}，错误 {4}，耗时 {5:0.0}s</sys:String>
    <sys:String x:Key="StatusCancelled">已取消</sys:String>
    <sys:String x:Key="StatusFailed">扫描失败</sys:String>
    <sys:String x:Key="StatusRescanRequired">清理已完成，当前扫描结果已失效，请重新扫描。</sys:String>
    <sys:String x:Key="FolderDialogDescription">选择要扫描的文件夹</sys:String>
    <sys:String x:Key="ScanFailedTitle">扫描失败</sys:String>
    <sys:String x:Key="CleanupBlockedTitle">无法清理</sys:String>
    <sys:String x:Key="CleanupBlockedDefault">路径被安全策略阻止。</sys:String>
    <sys:String x:Key="CleanupConfirmTitle">确认清理</sys:String>
    <sys:String x:Key="CleanupConfirmFormat">将把 {0} 项移入回收站，预计释放 {1}。被阻止项：{2}。是否继续？</sys:String>
    <sys:String x:Key="CleanupCompleteTitle">清理完成</sys:String>
    <sys:String x:Key="CleanupCompleteFormat">已处理 {0} 项，失败 {1} 项。</sys:String>
</ResourceDictionary>
