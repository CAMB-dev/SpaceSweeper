<Window x:Class="SpaceSweeper.App.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Width="460"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Border Margin="16"
            Background="#FFFFFF"
            BorderBrush="#D9E0E7"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
        <DockPanel>
            <Button DockPanel.Dock="Bottom"
                    Content="{DynamicResource CloseButton}"
                    HorizontalAlignment="Right"
                    MinWidth="88"
                    Height="32"
                    Margin="0,18,0,0"
                    Click="OnCloseClick" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{DynamicResource MaxWorkersLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Text="{Binding MaxDegreeOfParallelism, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         Margin="0,0,0,12" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="{DynamicResource ProgressIntervalLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding ProgressItemInterval, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         Margin="0,0,0,12" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="{DynamicResource SnapshotIntervalLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding SnapshotItemInterval, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         Margin="0,0,0,12" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="{DynamicResource SnapshotThrottleLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,12" />
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding SnapshotMinimumIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                         Height="30"
                         Margin="0,0,0,12" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="{DynamicResource SnapshotChildrenLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding MaximumSnapshotChildren, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
